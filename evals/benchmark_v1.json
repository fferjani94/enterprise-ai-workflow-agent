{
  "schema_version": 1,
  "name": "benchmark_v1",
  "description": "OpsPilot offline benchmark: successful investigations, missing accounts, incomplete evidence, unsafe conclusions and tool discipline. Model replies are scripted, so the cases evaluate orchestration, retrieval and answer guardrails, not model quality. Narrative-scoped facts must appear in the model-written text, not only in the deterministic record sections.",
  "cases": [
    {
      "id": "S1",
      "category": "success",
      "description": "Open tickets for one named account: the synthesis states the open ticket and its count.",
      "question": "List all open support tickets for Northstar Labs.",
      "script": {
        "tool_loop": [
          {"tool_calls": [{"tool": "get_account_tickets", "args": {"account_id": 1, "status": "open", "limit": 50}}]}
        ],
        "synthesis": [
          {"text": "Northstar Labs (Account 1) has one open support ticket: Ticket 101, \"Intermittent login failures\", with high priority."}
        ]
      },
      "expect": {
        "answer": {
          "source_in": ["synthesis"],
          "required_facts": [
            {"description": "ticket 101 is named", "scope": "narrative", "any_of": ["Ticket\\s*#?\\s*101\\b", "#101\\b"]},
            {"description": "one open ticket", "scope": "narrative", "any_of": ["\\b(?:one|1|a single) open (?:support )?ticket\\b", "only open (?:support )?ticket\\b"]}
          ],
          "forbidden_claims": [
            {"description": "resolved ticket presented as open", "any_of": ["Ticket\\s*#?\\s*102\\b", "Dashboard loading slowly"]}
          ]
        },
        "grounding": {
          "required_evidence": [{"type": "account", "id": 1}, {"type": "ticket", "id": 101}]
        },
        "completion": {"status": "completed", "coverage": [{"account_id": 1, "state": "complete"}]},
        "efficiency": {
          "required_tools": ["search_accounts", "get_account_tickets"],
          "forbidden_tools": ["search_knowledge", "get_ticket_details"],
          "max_executed_calls": 2,
          "max_rounds": 2,
          "max_rejected_proposals": 0
        }
      }
    },
